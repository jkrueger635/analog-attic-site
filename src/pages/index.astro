---
import Base from '../layouts/Base.astro';

const tracks = [
  { title: 'Patterns by Safespace', file: 'Patterns-MV2-1.mp3' },
  { title: "Sunshine by Leila's Rose", file: '04-Sunshine.mp3' },
  { title: 'Vultures by Safespace', file: 'Vultures-with-intro-MV3.mp3' },
  { title: "Evergreen by Leila's Rose", file: '01-Evergreen.mp3' },
  { title: 'Bed of Flowers by Peyton Maas', file: 'Bed-Of-Flowers-REF2.mp3' },
];
const services = [
  { icon: 'toolbox', title: 'Pre-Production', text: 'Get your songs finely tuned before hitting the studio, ensuring a solid foundation for success.' },
  { icon: 'note', title: 'Recording & Production', text: 'Capture your performances with pristine clarity and professional-grade equipment.' },
  { icon: 'mix', title: 'Mixing', text: 'Let me bring out the best in each element of your track, creating a balanced and polished sound.' },
  { icon: 'wave', title: 'Mastering', text: 'Give your music that final touch of perfection, with our expert mastering techniques that optimize your tracks for all listening environments.' },
];
const icons = {
  toolbox: '<path d="M9 6V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V6"/><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 12h18M10 12v2h4v-2"/>',
  note: '<path d="M9 18V5l11-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>',
  mix: '<path d="M4 20V10M10 20V4M16 20V13M22 20V8"/>',
  wave: '<path d="M2 12h2M6 8v8M10 4v16M14 7v10M18 9v6M22 12h-1"/>',
};
---
<Base>
  <section class="about" id="about">
    <div class="wrap split">
      <img class="portrait" src="/images/jake.webp" alt="Jacob Wichert in his Omaha recording studio" width="1000" height="667" fetchpriority="high" />
      <div>
        <h1>Jacob Wichert</h1>
        <p>Greetings! I’m an artist and mixing engineer rooted in Omaha, NE. From my early days, I’ve been immersed in the world of writing, recording, and mixing music. My purpose is to aid artists in providing their next project with the greatest chance of discovery. I specialize in crafting top-notch mixes that not only sound incredible, but also resonate seamlessly across various platforms and environments. Together, let’s ensure your music receives the attention it deserves!</p>
        <a class="btn" href="#contact">Contact Me</a>
      </div>
    </div>
  </section>

  <section class="band" id="Sounds">
    <div class="wrap split">
      <div>
        <h2>Listen to My Work</h2>
        <p>Before diving into our portfolio of released recordings, take a moment to imagine the impact your music could have on listeners worldwide. With my passion for quality and attention to detail, I have helped numerous artists like you transform their songs into captivating sonic experiences.</p>
        <p>From melodic hooks that stick in your head to powerful beats that move your body, our work speaks volumes for our commitment to excellence. Explore our Spotify portfolio and get a taste of what we can do for your music.</p>
        <a class="btn" href="#contact">Contact Me</a>
      </div>
      <ul class="tracks">
        {tracks.map((t, i) => (
          <li class={i % 2 ? 'filled' : ''}>
            <p class="track-title" id={`trk${i + 1}`}>{t.title}</p>
            <audio controls preload="none" src={`/audio/${t.file}`} aria-labelledby={`trk${i + 1}`}>
              Your browser does not support audio playback. <a href={`/audio/${t.file}`}>Download {t.title}</a>.
            </audio>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="Services">
    <div class="wrap split">
      <div>
        <h2>How can I help?</h2>
        <ul class="services">
          {services.map((s) => (
            <li>
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="collage">
        <img src="/images/software-coffee.webp" alt="Studio monitors and a computer running recording software" width="640" height="427" loading="lazy" />
        <img src="/images/guitar-amp-microphones.webp" alt="Orange guitar amp with microphones" width="640" height="427" loading="lazy" />
        <img src="/images/microphone.webp" alt="Studio microphone" width="400" height="600" loading="lazy" />
        <img src="/images/drumkit.webp" alt="Drum kit set up in the recording room" width="400" height="600" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="band quote">
    <div class="wrap narrow center">
      <p class="stars" aria-label="Five out of five stars">★★★★★</p>
      <blockquote><p>I absolutely loved working with Jacob at Analog Attic. He made a very comfortable working environment, was very patient &amp; creative with any problem solving, &amp; we were able in a very short time to come away with songs we could both feel proud of. Plus, the supervisor was very cute &amp; sweet (Piper the cat).</p></blockquote>
    </div>
  </section>

  <section class="feed" aria-labelledby="ig-h">
    <div class="wrap">
      <h2 class="sr-only" id="ig-h">Latest from Instagram</h2>
      <!-- Elfsight Instagram Feed (edit the widget in the Elfsight dashboard) -->
      <div class="elfsight-app-bdefb3f3-e883-49ab-ae44-796cfe1e8c9b" data-elfsight-app-lazy></div>
    </div>
  </section>

  <section class="contact" id="contact">
    <img class="contact-bg" src="/images/drumsticks.webp" alt="" width="1000" height="667" loading="lazy" />
    <div class="wrap narrow center">
      <h2>Contact Me!</h2>
      <p>Let's Talk About Your Musical Goals And See If We're A Fit.</p>
      <div class="form-card">
        <!-- Elfsight Contact Form | Analog Attic Form -->
        <div class="elfsight-app-1eb79db2-09a0-4862-9e1f-b9b868a1f7c5" data-elfsight-app-lazy></div>
      </div>
    </div>
  </section>

  <script slot="foot" is:inline src="https://elfsightcdn.com/platform.js" async></script>
</Base>
