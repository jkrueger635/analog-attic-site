---
import { site } from '../data/site.js';
---
<header class="site">
  <div class="wrap bar">
    <a class="logo" href="/"><img src="/images/logo.webp" alt="Analog Attic logo" width="80" height="80" /></a>
    <nav aria-label="Main">
      <a href="/#Services">Services</a>
      <a href="/#Sounds">Sounds</a>
      <a class="btn" href="/#contact">Contact Me</a>
      <a class="ig" href={site.instagram} rel="noopener" aria-label="Analog Attic on Instagram">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </nav>
  </div>
</header>
